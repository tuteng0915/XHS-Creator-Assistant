diff --git a/tests/test_xhs_creator_state_parser.py b/tests/test_xhs_creator_state_parser.py
new file mode 100644
index 0000000..b06d494
--- /dev/null
+++ b/tests/test_xhs_creator_state_parser.py
@@ -0,0 +1,94 @@
+"""Offline regression checks for the creator homepage HTML adapter."""
+
+from unittest.mock import AsyncMock
+
+import pytest
+
+import config
+from media_platform.xhs.core import XiaoHongShuCrawler
+from media_platform.xhs.extractor import CreatorStateParseError, XiaoHongShuExtractor
+from store import xhs as xhs_store
+
+
+def test_creator_state_accepts_bare_undefined_without_changing_strings():
+    html = (
+        '<script>window.__INITIAL_STATE__={"user":{"userPageData":'
+        '{"basicInfo":{"nickname":"中文账号"}}},"extras":'
+        '[undefined, {"value": undefined, "literal":"undefined",'
+        '"emptySet":new Set([]),"setLiteral":"new Set([])"}]};</script>'
+        '<script>window.other={"secret":"not part of creator state"}</script>'
+    )
+
+    creator = XiaoHongShuExtractor().extract_creator_info_from_html(html)
+
+    assert creator["basicInfo"]["nickname"] == "中文账号"
+
+
+def test_creator_state_does_not_guess_how_to_convert_nonempty_sets():
+    html = (
+        '<script>window.__INITIAL_STATE__={"user":{"userPageData":'
+        '{"items":new Set(["private-value"])}}}</script>'
+    )
+
+    with pytest.raises(CreatorStateParseError, match="position") as error:
+        XiaoHongShuExtractor().extract_creator_info_from_html(html)
+
+    assert "private-value" not in str(error.value)
+
+
+def test_creator_state_failure_reports_position_without_response_content():
+    html = (
+        '<script>window.__INITIAL_STATE__={"user":{"userPageData":'
+        '{"secret":"private-session", "bad": broken}}}</script>'
+    )
+
+    with pytest.raises(CreatorStateParseError, match="position") as error:
+        XiaoHongShuExtractor().extract_creator_info_from_html(html)
+
+    assert "private-session" not in str(error.value)
+    assert "broken" not in str(error.value)
+
+
+@pytest.mark.asyncio
+async def test_creator_note_detail_uses_profile_source_when_list_omits_it():
+    crawler = XiaoHongShuCrawler()
+    crawler.get_note_detail_async_task = AsyncMock(return_value=None)
+
+    await crawler.fetch_creator_notes_detail([{"note_id": "n1", "xsec_token": "token"}])
+
+    assert crawler.get_note_detail_async_task.await_args.kwargs["xsec_source"] == "pc_user"
+
+
+@pytest.mark.asyncio
+async def test_saved_note_url_keeps_its_actual_source(monkeypatch):
+    store = AsyncMock()
+    monkeypatch.setattr(xhs_store.XhsStoreFactory, "create_store", lambda: store)
+
+    await xhs_store.update_xhs_note({
+        "note_id": "n1", "desc": "测试正文", "xsec_token": "token",
+        "xsec_source": "pc_user", "user": {}, "interact_info": {},
+    })
+
+    saved = store.store_content.await_args.args[0]
+    assert saved["note_url"].endswith("xsec_source=pc_user")
+
+
+@pytest.mark.asyncio
+async def test_unusable_creator_state_is_not_a_successful_crawl(monkeypatch, caplog):
+    monkeypatch.setattr(
+        config,
+        "XHS_CREATOR_ID_LIST",
+        ["https://www.xiaohongshu.com/user/profile/test?xsec_token=private-token&xsec_source=app_share"],
+    )
+    crawler = XiaoHongShuCrawler()
+    crawler.xhs_client = AsyncMock()
+    crawler.xhs_client.get_creator_info.side_effect = CreatorStateParseError(
+        "homepage state JSON is invalid at position 42"
+    )
+
+    with pytest.raises(RuntimeError, match="No creator homepage was processed"):
+        await crawler.get_creators_and_notes()
+
+    crawler.xhs_client.get_all_notes_by_creator.assert_not_called()
+    assert "Creator homepage state parse failed" in caplog.text
+    assert "private-token" not in caplog.text
